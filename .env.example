APP_NAME="Project L.E.A.F."
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local-leaf
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Laravel publishes broadcast events to this host from the same Ubuntu machine.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb listens on all interfaces for local intranet testing.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Browser WebSocket host. Leave empty to use the host serving the dashboard,
# or set this to the Ubuntu laptop LAN IP when the browser is on another device.
VITE_BROADCAST_CONNECTION=reverb
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443
PUSHER_HOST=

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LEAF_DASHBOARD_DEVICE_DB_ID=358
LEAF_DASHBOARD_FAKE_TELEMETRY_FIRMWARE=leaf-fake-dashboard-telemetry
LEAF_DASHBOARD_REALTIME_TELEMETRY=true
LEAF_DASHBOARD_TELEMETRY_POLLING_FALLBACK=false

# MQTT broker configuration for local intranet testing
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=leaf-mqtt-subscriber
MQTT_QOS=0
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_TELEMETRY=leaf/devices/+/telemetry
MQTT_TOPIC_STATUS=leaf/devices/+/status
MQTT_TOPIC_RESULTS=leaf/devices/+/results
MQTT_TOPIC_COMMANDS=leaf/devices/{device_id}/commands
